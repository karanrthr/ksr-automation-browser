<Window x:Class="KsrAutomationBrowser.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KSR Automation Browser" Width="1020" Height="700" MinWidth="880" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F6F8FB">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="KSR Automation Browser" FontSize="30" FontWeight="SemiBold" Foreground="#12324A"/><TextBlock Text="Chromium-powered workspace for reliable extension automation" FontSize="14" Foreground="#52616B" Margin="0,5,0,20"/></StackPanel>
  <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18"><Border Background="White" CornerRadius="8" Margin="4" Padding="14"><StackPanel><TextBlock Text="ACTIVE PROFILE" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="ProfileText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DownloadText" TextWrapping="Wrap" Foreground="#52616B"/></StackPanel></Border><Border Background="White" CornerRadius="8" Margin="4" Padding="14"><StackPanel><TextBlock Text="BROWSER" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="BrowserText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="LaunchText" Foreground="#52616B"/></StackPanel></Border><Border Background="White" CornerRadius="8" Margin="4" Padding="14"><StackPanel><TextBlock Text="AUTOMATION HOST" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="HostText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ExtensionText" Foreground="#52616B"/></StackPanel></Border></UniformGrid>
  <ScrollViewer Grid.Row="2"><UniformGrid Columns="3"><Button Content="Open Browser" Click="OpenBrowser_Click" Background="#1769AA" Foreground="White"/><Button Content="Open Gemini" Click="OpenGemini_Click"/><Button Content="Open ChatGPT" Click="OpenChatGpt_Click"/><Button Content="Select Download Folder" Click="SelectDownload_Click"/><Button Content="Open Download Folder" Click="OpenDownloads_Click"/><Button Content="Install Extension ZIP" Click="InstallZip_Click"/><Button Content="Install Unpacked Extension" Click="InstallUnpacked_Click"/><Button Content="Manage Extensions" Click="ManageExtensions_Click"/><Button Content="Open Chromium Extensions Page" Click="ExtensionsPage_Click"/><Button Content="Create Profile" Click="CreateProfile_Click"/><Button Content="Manage Profiles" Click="ManageProfiles_Click"/><Button Content="Open Logs" Click="OpenLogs_Click"/><Button Content="Repair Browser" Click="Repair_Click"/><Button Content="Check Browser Files" Click="Check_Click"/><Button Content="Exit" Click="Exit_Click"/></UniformGrid></ScrollViewer>
  <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="#52616B" Margin="5,14,5,0"/>
 </Grid>
</Window>
